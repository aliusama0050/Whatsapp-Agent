# Environment (development | production)
ENVIRONMENT=development

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_app_secret_from_meta_dashboard

# Ollama Cloud AI
OLLAMA_BASE_URL=https://your-ollama-instance.com
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=ollama

# Server
PORT=8000

# PostgreSQL (local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hsq_whatsapp

# PostgreSQL (Supabase) — uncomment and replace above
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL_SYNC=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT Auth
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin (auto-seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute
